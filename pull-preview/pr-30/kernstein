#!/bin/sh
# Kernstein Remote launcher for the verified Tailscale + OpenSSH + RDP path.
# Release: 0.2.0
# Source: https://github.com/eahenle/eahenle.github.io

# Keep all executable statements inside main. When this file is piped to sh,
# an interrupted download therefore cannot reach the final invocation below.

# POSIX sh does not define pipefail. Commands whose status matters write to
# temporary files and are checked directly instead of relying on pipelines.
set -u

readonly PROGRAM_NAME="kernstein-remote"
readonly RELEASE_VERSION="0.2.0"
readonly SCHEMA_VERSION="1"
readonly EX_CONFIG=78
readonly EX_UNAVAILABLE=69

# Verified public connection contract. Credentials remain local to the Mac.
readonly EXPECTED_SSH_HOSTNAME="kernstein.tail83f91c.ts.net"
readonly EXPECTED_SSH_USER="graf"
readonly EXPECTED_HOST_KEY_ALIAS="kernstein"
readonly EXPECTED_SSH_HOST_KEY_FINGERPRINT="SHA256:pVBg+iXWeVA2Sk2p9nD8PTFp++gDIGJzICIgToQND44"
readonly EXPECTED_IDENTITY_FILE_RELATIVE=".ssh/id_ed25519_kernstein"
readonly EXPECTED_REMOTE_HOSTNAME="kernstein"
readonly REMOTE_RDP_HOST="127.0.0.1"
readonly REMOTE_RDP_PORT="3389"
readonly LOCAL_RDP_HOST="127.0.0.1"
readonly LOCAL_RDP_PORT="3389"
readonly WINDOWS_PC_NAME="Kernstein Desktop"

say() {
  printf '%s\n' "$*" >&2
}

die() {
  code=$1
  shift
  say "${PROGRAM_NAME}: $*"
  exit "$code"
}

usage() {
  cat <<EOF
Kernstein Remote ${RELEASE_VERSION}

Usage: kernstein [--check | --status | --start | --stop | --restart | --version]

  no option    validate, start the SSH tunnel, and open Windows App
  --check      verify this Mac and the live private connection
  --status     verify readiness and report local tunnel state
  --start      verify readiness and start the SSH tunnel
  --stop       stop the launcher-managed SSH tunnel
  --restart    restart the SSH tunnel after verification
  --version    print the launcher release

Configuration: ~/.config/kernstein-remote/connection.json
Local endpoint: ${LOCAL_RDP_HOST}:${LOCAL_RDP_PORT}
Saved Windows App PC: ${WINDOWS_PC_NAME}
EOF
}

config_path() {
  if [ -n "${KERNSTEIN_CONFIG_HOME:-}" ]; then
    printf '%s/kernstein-remote/connection.json\n' "$KERNSTEIN_CONFIG_HOME"
  elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s/kernstein-remote/connection.json\n' "$XDG_CONFIG_HOME"
  else
    printf '%s/.config/kernstein-remote/connection.json\n' "$HOME"
  fi
}

state_directory() {
  if [ -n "${KERNSTEIN_STATE_HOME:-}" ]; then
    printf '%s/kernstein-remote\n' "$KERNSTEIN_STATE_HOME"
  elif [ -n "${XDG_STATE_HOME:-}" ]; then
    printf '%s/kernstein-remote\n' "$XDG_STATE_HOME"
  else
    printf '%s/.local/state/kernstein-remote\n' "$HOME"
  fi
}

windows_app_path() {
  printf '%s\n' "${KERNSTEIN_WINDOWS_APP_PATH:-/Applications/Windows App.app}"
}

require_macos() {
  os=$(uname -s 2>/dev/null || printf unknown)
  [ "$os" = Darwin ] || die "$EX_UNAVAILABLE" "unsupported operating system '$os'; macOS is required"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    die "$EX_UNAVAILABLE" "required macOS tool '$1' was not found"
}

require_prerequisites() {
  for required_command in awk lsof open osascript plutil shlock ssh ssh-keygen; do
    require_command "$required_command"
  done

  if command -v tailscale >/dev/null 2>&1; then
    TAILSCALE_BIN=$(command -v tailscale)
  elif [ -x "/Applications/Tailscale.app/Contents/MacOS/Tailscale" ]; then
    TAILSCALE_BIN="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
  else
    die "$EX_UNAVAILABLE" "Tailscale is not installed; install and enroll the official macOS client"
  fi

  WINDOWS_APP_PATH=$(windows_app_path)
  [ -d "$WINDOWS_APP_PATH" ] ||
    die "$EX_UNAVAILABLE" "Windows App is not installed at $WINDOWS_APP_PATH"
}

initialize_config() {
  path=$1
  directory=${path%/*}
  [ "$directory" != "$path" ] || die "$EX_CONFIG" "configuration path must include a directory"

  old_umask=$(umask)
  umask 077
  if ! mkdir -p "$directory"; then
    umask "$old_umask"
    die "$EX_CONFIG" "could not create configuration directory: $directory"
  fi
  temporary="$directory/.connection.json.$$"
  trap 'rm -f "$temporary"' 0 1 2 3 15
  if ! printf '{\n  "schema_version": 1\n}\n' >"$temporary" || ! chmod 600 "$temporary"; then
    rm -f "$temporary"
    trap - 0 1 2 3 15
    umask "$old_umask"
    die "$EX_CONFIG" "could not initialize configuration: $path"
  fi
  # A hard link installs the complete file atomically and, unlike mv, fails if
  # another process has created the destination since main checked it.
  if ! ln "$temporary" "$path" 2>/dev/null; then
    rm -f "$temporary"
    trap - 0 1 2 3 15
    umask "$old_umask"
    if [ -e "$path" ]; then
      say "${PROGRAM_NAME}: configuration appeared during initialization; preserving it"
      return 0
    fi
    die "$EX_CONFIG" "could not install configuration without overwriting: $path"
  fi
  rm -f "$temporary"
  trap - 0 1 2 3 15
  umask "$old_umask"
  say "${PROGRAM_NAME}: initialized restrictive configuration at $path"
}

validate_config() {
  path=$1
  [ -f "$path" ] || die "$EX_CONFIG" "configuration is not a regular file: $path"

  # plutil accepts XML, binary, OpenStep, and relaxed JSON-like property lists.
  # JavaScript's JSON.parse enforces the documented JSON object format first;
  # the file stays on standard input instead of appearing in process arguments.
  osascript -l JavaScript -e '
ObjC.import("Foundation");
const data = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
const text = ObjC.unwrap(
  $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding)
);
const value = JSON.parse(text);
if (value === null || Array.isArray(value) || typeof value !== "object") {
  throw new Error("configuration root must be an object");
}
' <"$path" >/dev/null 2>&1 ||
    die "$EX_CONFIG" "configuration is not valid JSON: $path"

  schema=$(plutil -extract schema_version raw -expect integer -o - "$path" 2>/dev/null) ||
    die "$EX_CONFIG" "configuration is missing integer schema_version"
  [ "$schema" = "$SCHEMA_VERSION" ] ||
    die "$EX_CONFIG" "unsupported schema_version '$schema' (expected $SCHEMA_VERSION)"
}

initialize_state() {
  STATE_DIRECTORY=$(state_directory)
  old_umask=$(umask)
  umask 077
  if ! mkdir -p "$STATE_DIRECTORY"; then
    umask "$old_umask"
    die "$EX_CONFIG" "could not create state directory: $STATE_DIRECTORY"
  fi
  if ! chmod 700 "$STATE_DIRECTORY"; then
    umask "$old_umask"
    die "$EX_CONFIG" "could not secure state directory: $STATE_DIRECTORY"
  fi
  umask "$old_umask"
  CONTROL_SOCKET="$STATE_DIRECTORY/tunnel.sock"
  TUNNEL_LOCK="$STATE_DIRECTORY/tunnel.lock"
  SSH_IDENTITY="$HOME/$EXPECTED_IDENTITY_FILE_RELATIVE"
  SSH_KNOWN_HOSTS="$HOME/.ssh/known_hosts_kernstein"
  SSH_DESTINATION="${EXPECTED_SSH_USER}@${EXPECTED_SSH_HOSTNAME}"
  LOCK_HELD=0
}

run_ssh() {
  ssh \
    -F /dev/null \
    -o IdentityFile="$SSH_IDENTITY" \
    -o IdentitiesOnly=yes \
    -o PubkeyAuthentication=yes \
    -o PasswordAuthentication=no \
    -o KbdInteractiveAuthentication=no \
    -o ForwardAgent=no \
    -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile="$SSH_KNOWN_HOSTS" \
    -o HostKeyAlias="$EXPECTED_HOST_KEY_ALIAS" \
    -o HostKeyAlgorithms=ssh-ed25519 \
    -o Port=22 \
    -o ConnectTimeout=8 \
    -o ProxyCommand=none \
    -o ProxyJump=none \
    "$@"
}

validate_ssh_contract() {
  [ -f "$SSH_IDENTITY" ] ||
    die "$EX_CONFIG" "dedicated SSH identity is missing: $SSH_IDENTITY"
  [ -f "$SSH_KNOWN_HOSTS" ] ||
    die "$EX_CONFIG" "pinned SSH host-key file is missing: $SSH_KNOWN_HOSTS"

  host_key_lookup="$STATE_DIRECTORY/.host-key-lookup.$$"
  host_keys="$STATE_DIRECTORY/.host-keys.$$"
  trap 'rm -f "$host_key_lookup" "$host_keys"' 0 1 2 3 15

  if ! ssh-keygen -F "$EXPECTED_HOST_KEY_ALIAS" -f "$SSH_KNOWN_HOSTS" \
    >"$host_key_lookup" 2>/dev/null; then
    die "$EX_CONFIG" "pinned SSH host key for '$EXPECTED_HOST_KEY_ALIAS' is missing"
  fi
  awk '!/^#/ && NF { print }' "$host_key_lookup" >"$host_keys"
  host_key_count=$(awk 'END { print NR + 0 }' "$host_keys")
  [ "$host_key_count" -eq 1 ] ||
    die "$EX_CONFIG" "pinned SSH host-key file must contain exactly one key for '$EXPECTED_HOST_KEY_ALIAS'"
  host_key_fingerprint=$(ssh-keygen -lf "$host_keys" 2>/dev/null |
    awk 'NR == 1 { print $2 }')
  [ "$host_key_fingerprint" = "$EXPECTED_SSH_HOST_KEY_FINGERPRINT" ] ||
    die "$EX_CONFIG" "SSH host-key fingerprint mismatch for '$EXPECTED_HOST_KEY_ALIAS'"

  rm -f "$host_key_lookup" "$host_keys"
  trap - 0 1 2 3 15
}

validate_private_path() {
  if ! "$TAILSCALE_BIN" ping --c 1 "$EXPECTED_SSH_HOSTNAME" >/dev/null 2>&1; then
    die "$EX_UNAVAILABLE" "Kernstein is not reachable through the enrolled Tailscale client"
  fi
  if ! run_ssh -o BatchMode=yes "$SSH_DESTINATION" \
    "test \"\$(hostname)\" = '$EXPECTED_REMOTE_HOSTNAME'"; then
    die "$EX_UNAVAILABLE" "authenticated OpenSSH access to Kernstein failed"
  fi
}

validate_operational_contract() {
  validate_ssh_contract
  validate_private_path
}

tunnel_running() {
  run_ssh -S "$CONTROL_SOCKET" -O check "$SSH_DESTINATION" >/dev/null 2>&1
}

release_tunnel_lock() {
  if [ "${LOCK_HELD:-0}" -eq 1 ]; then
    rm -f "$TUNNEL_LOCK"
    LOCK_HELD=0
  fi
}

acquire_tunnel_lock() {
  # macOS shlock atomically records this process ID and replaces a lock whose
  # owner no longer exists, so a crash or forced restart cannot wedge control.
  if ! shlock -f "$TUNNEL_LOCK" -p "$$"; then
    die "$EX_UNAVAILABLE" "another tunnel operation is in progress; retry after it finishes"
  fi
  LOCK_HELD=1
  trap 'release_tunnel_lock' 0
  trap 'release_tunnel_lock; exit 69' 1 2 3 15
}

finish_tunnel_operation() {
  if ! rm -f "$TUNNEL_LOCK"; then
    LOCK_HELD=0
    trap - 0 1 2 3 15
    die "$EX_UNAVAILABLE" "could not release tunnel operation lock: $TUNNEL_LOCK"
  fi
  LOCK_HELD=0
  trap - 0 1 2 3 15
}

start_tunnel_locked() {
  if tunnel_running; then
    say "${PROGRAM_NAME}: tunnel already running at ${LOCAL_RDP_HOST}:${LOCAL_RDP_PORT}"
    return 0
  fi

  [ ! -e "$CONTROL_SOCKET" ] || rm -f "$CONTROL_SOCKET"
  if lsof -nP -iTCP:"$LOCAL_RDP_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    die "$EX_UNAVAILABLE" "local TCP port $LOCAL_RDP_PORT is already in use"
  fi

  if ! run_ssh -M -S "$CONTROL_SOCKET" -fN \
    -L "${LOCAL_RDP_HOST}:${LOCAL_RDP_PORT}:${REMOTE_RDP_HOST}:${REMOTE_RDP_PORT}" \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    "$SSH_DESTINATION"; then
    die "$EX_UNAVAILABLE" "could not start the authenticated RDP tunnel"
  fi
  tunnel_running || die "$EX_UNAVAILABLE" "SSH exited without a usable control tunnel"
  say "${PROGRAM_NAME}: tunnel started at ${LOCAL_RDP_HOST}:${LOCAL_RDP_PORT}"
}

stop_tunnel_locked() {
  if tunnel_running; then
    if ! run_ssh -S "$CONTROL_SOCKET" -O exit "$SSH_DESTINATION" >/dev/null; then
      die "$EX_UNAVAILABLE" "could not stop the SSH tunnel"
    fi
    say "${PROGRAM_NAME}: tunnel stopped"
  else
    say "${PROGRAM_NAME}: tunnel is not running"
    [ ! -e "$CONTROL_SOCKET" ] || rm -f "$CONTROL_SOCKET"
  fi
}

start_tunnel() {
  acquire_tunnel_lock
  start_tunnel_locked
  finish_tunnel_operation
}

stop_tunnel() {
  acquire_tunnel_lock
  stop_tunnel_locked
  finish_tunnel_operation
}

restart_tunnel() {
  acquire_tunnel_lock
  stop_tunnel_locked
  start_tunnel_locked
  finish_tunnel_operation
}

show_status() {
  say "${PROGRAM_NAME}: release $RELEASE_VERSION; verified private path is ready"
  if tunnel_running; then
    say "${PROGRAM_NAME}: tunnel running at ${LOCAL_RDP_HOST}:${LOCAL_RDP_PORT}"
  else
    say "${PROGRAM_NAME}: tunnel stopped"
  fi
}

open_windows_app() {
  if ! open "$WINDOWS_APP_PATH"; then
    die "$EX_UNAVAILABLE" "could not open Windows App"
  fi
  # Best-effort navigation only. The saved PC remains persistent in Windows App.
  osascript <<'APPLESCRIPT' >/dev/null 2>&1 || true
tell application "System Events" to tell process "Windows App"
  set frontmost to true
  if exists menu item "Connection Center" of menu 1 of menu bar item "Window" of menu bar 1 then
    click menu item "Connection Center" of menu 1 of menu bar item "Window" of menu bar 1
  end if
end tell
APPLESCRIPT
  say "${PROGRAM_NAME}: Windows App opened; connect to the saved PC '$WINDOWS_PC_NAME'"
}

main() {
  action=${1:-launch}
  [ "$#" -le 1 ] || die 64 "unexpected arguments (try --help)"
  case "$action" in
    --help|-h) usage; exit 0 ;;
    --version) printf '%s\n' "$RELEASE_VERSION"; exit 0 ;;
    launch|--check|--status|--start|--stop|--restart) ;;
    *) die 64 "unknown option '$action' (try --help)" ;;
  esac

  require_macos
  if [ "$action" = --stop ]; then
    require_command ssh
    initialize_state
    stop_tunnel
    exit 0
  fi
  require_prerequisites
  path=$(config_path)
  if [ ! -e "$path" ]; then
    initialize_config "$path"
  fi
  validate_config "$path"
  initialize_state

  case "$action" in
    --check)
      validate_operational_contract
      say "${PROGRAM_NAME}: Tailscale, OpenSSH, host identity, Windows App, and configuration are ready"
      ;;
    --status)
      validate_operational_contract
      show_status
      ;;
    --start)
      validate_operational_contract
      start_tunnel
      ;;
    --restart)
      validate_operational_contract
      restart_tunnel
      ;;
    launch)
      validate_operational_contract
      start_tunnel
      open_windows_app
      ;;
  esac
}

main "$@"
