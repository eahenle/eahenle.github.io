#!/bin/sh
# Kernstein Remote bootstrap (contract-ready preview; connectivity is not enabled).
# Release: 0.1.0-precontract.1
# Source: https://github.com/eahenle/eahenle.github.io

# Keep all executable statements inside main.  When this file is piped to sh,
# an interrupted download therefore cannot reach the final invocation below.

set -u

readonly PROGRAM_NAME="kernstein-remote"
readonly RELEASE_VERSION="0.1.0-precontract.1"
readonly SCHEMA_VERSION="1"
readonly EX_CONFIG=78
readonly EX_UNAVAILABLE=69

say() {
  printf '%s\n' "$*" >&2
}

die() {
  code=$1
  shift
  say "${PROGRAM_NAME}: $*"
  exit "$code"
}

usage() {
  cat <<EOF
Kernstein Remote ${RELEASE_VERSION}

Usage: kernstein [--check | --status | --version]

  --check    validate this Mac and the local configuration
  --status   report release and configuration readiness
  --version  print the launcher release

Configuration: ~/.config/kernstein-remote/connection.json

This preview intentionally cannot establish connectivity until the verified
KERNSTEIN_CLIENT_CONTRACT is incorporated. It contains no endpoint, account,
credential, enrollment key, application identifier, or launch URI.
EOF
}

config_path() {
  if [ -n "${KERNSTEIN_CONFIG_HOME:-}" ]; then
    printf '%s/kernstein-remote/connection.json\n' "$KERNSTEIN_CONFIG_HOME"
  elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s/kernstein-remote/connection.json\n' "$XDG_CONFIG_HOME"
  else
    printf '%s/.config/kernstein-remote/connection.json\n' "$HOME"
  fi
}

require_macos() {
  os=$(uname -s 2>/dev/null || printf unknown)
  [ "$os" = Darwin ] || die "$EX_UNAVAILABLE" "unsupported operating system '$os'; macOS is required"
}

require_prerequisites() {
  command -v plutil >/dev/null 2>&1 || die "$EX_UNAVAILABLE" "required macOS tool 'plutil' was not found"
}

initialize_config() {
  path=$1
  directory=${path%/*}
  [ "$directory" != "$path" ] || die "$EX_CONFIG" "configuration path must include a directory"

  old_umask=$(umask)
  umask 077
  if ! mkdir -p "$directory"; then
    umask "$old_umask"
    die "$EX_CONFIG" "could not create configuration directory: $directory"
  fi
  temporary="$directory/.connection.json.$$"
  trap 'rm -f "$temporary"' 0 1 2 3 15
  if ! printf '{\n  "schema_version": 1\n}\n' >"$temporary" || ! chmod 600 "$temporary" || ! mv "$temporary" "$path"; then
    rm -f "$temporary"
    trap - 0 1 2 3 15
    umask "$old_umask"
    die "$EX_CONFIG" "could not initialize configuration: $path"
  fi
  trap - 0 1 2 3 15
  umask "$old_umask"
  say "${PROGRAM_NAME}: initialized restrictive configuration at $path"
}

validate_config() {
  path=$1
  [ -f "$path" ] || die "$EX_CONFIG" "configuration is not a regular file: $path"
  plutil -lint "$path" >/dev/null 2>&1 || die "$EX_CONFIG" "configuration is not valid JSON: $path"

  schema=$(plutil -extract schema_version raw -o - "$path" 2>/dev/null) ||
    die "$EX_CONFIG" "configuration is missing integer schema_version"
  [ "$schema" = "$SCHEMA_VERSION" ] ||
    die "$EX_CONFIG" "unsupported schema_version '$schema' (expected $SCHEMA_VERSION)"
}

main() {
  action=${1:-launch}
  [ "$#" -le 1 ] || die 64 "unexpected arguments (try --help)"
  case "$action" in
    --help|-h) usage; exit 0 ;;
    --version) printf '%s\n' "$RELEASE_VERSION"; exit 0 ;;
    launch|--check|--status) ;;
    *) die 64 "unknown option '$action' (try --help)" ;;
  esac

  require_macos
  require_prerequisites
  path=$(config_path)
  if [ ! -e "$path" ]; then
    initialize_config "$path"
  fi
  validate_config "$path"

  case "$action" in
    --check)
      say "${PROGRAM_NAME}: macOS prerequisites and schema_version 1 configuration are valid"
      ;;
    --status)
      say "${PROGRAM_NAME}: release $RELEASE_VERSION; configuration valid; client contract pending"
      ;;
    launch)
      die "$EX_CONFIG" "connection is not enabled in this pre-contract release; no network or app action was taken"
      ;;
  esac
}

main "$@"
